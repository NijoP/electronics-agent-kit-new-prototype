{
  "name": "E2 editor correctness and atomicity",
  "description": "Opens an isolated software fixture project and drives the schematic with real X input: places a part, clicks the placed part with the Place tool (no second part on top), marks a pin No connect and clicks it again (the marker is removed with DeleteNoConnect), draws an L-shaped wire (one Batch: one revision) and undoes it once (both legs go: one undo step). Then the PCB layer-count select lists 2..16 copper layers. Then (fix place-selbar) the canvas keeps its position when a selection appears, and Place menu picks switch the tool while Place is armed. Then (A5) the inspector in the right dock shows the Label tool's options, the selected part's fields (a Value edit is one SetSymbolValue), the document with the title block unavailable, and in the PCB the routing options while Route is active.",
  "steps": [
    {
      "id": "home",
      "do": "wait",
      "title": "Project Home visible",
      "selector": "main.home h1",
      "timeout": 60000
    },
    {
      "id": "fixture",
      "do": "fixture-project",
      "title": "Create fixture project",
      "name": "E2 Editor Fixture",
      "folder": "e2-editor-fixture"
    },
    {
      "id": "open",
      "do": "click",
      "title": "Open fixture from Recent projects",
      "selector": "button.home-row",
      "text": "E2 Editor Fixture",
      "expect": "nav[aria-label=\"Application menu\"]"
    },
    {
      "id": "sch",
      "do": "menu",
      "title": "Open schematic",
      "menu": "View",
      "item": "Go to Schematic editor",
      "expect": "section[aria-label=\"Schematic view\"]"
    },
    {
      "id": "e2-place-tool",
      "do": "click",
      "title": "E2: Place tool (editor tool button)",
      "shot": false,
      "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button",
      "text": "Place",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "Place"
    },
    {
      "id": "e2-place",
      "do": "click",
      "title": "E2: click the empty sheet places one part (PlaceSymbol)",
      "selector": "section[aria-label=\"Schematic view\"] svg.canvas",
      "expect": "footer.status span.msg",
      "expectText": "PlaceSymbol"
    },
    {
      "id": "e2-place-count",
      "do": "count",
      "title": "E2: one symbol on the sheet",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]",
      "equals": 1,
      "shot": false
    },
    {
      "id": "e2-place-on-symbol",
      "do": "click",
      "title": "E2: Place-tool click on the placed part (it is selected, nothing placed on top)",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body"
    },
    {
      "id": "e2-place-on-symbol-count",
      "do": "count",
      "title": "E2: still one symbol on the sheet",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]",
      "equals": 1,
      "timeout": 3000,
      "shot": false
    },
    {
      "id": "e2-nc-tool",
      "do": "click",
      "title": "E2: No connect tool (editor tool button)",
      "shot": false,
      "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button",
      "text": "No connect",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "No connect"
    },
    {
      "id": "e2-nc-set",
      "do": "click",
      "title": "E2: click a pin marks it (SetNoConnect)",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] circle.pin-end",
      "expect": "footer.status span.msg",
      "expectText": "SetNoConnect"
    },
    {
      "id": "e2-nc-set-count",
      "do": "count",
      "title": "E2: one no-connect marker drawn",
      "selector": "section[aria-label=\"Schematic view\"] path.no-connect",
      "equals": 1,
      "shot": false
    },
    {
      "id": "e2-nc-again",
      "do": "click",
      "title": "E2: click the marked pin again removes the marker (DeleteNoConnect, never a duplicate)",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] circle.pin-end",
      "expect": "footer.status span.msg",
      "expectText": "DeleteNoConnect"
    },
    {
      "id": "e2-nc-again-count",
      "do": "count",
      "title": "E2: no marker left",
      "selector": "section[aria-label=\"Schematic view\"] path.no-connect",
      "equals": 0,
      "shot": false
    },
    {
      "id": "e2-wire-tool",
      "do": "click",
      "title": "E2: Wire tool (editor tool button)",
      "shot": false,
      "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button",
      "text": "Wire",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "Wire"
    },
    {
      "id": "e2-wire-start",
      "do": "click",
      "title": "E2: wire start point",
      "selector": "section[aria-label=\"Schematic view\"] svg.canvas",
      "dx": -220,
      "dy": -160,
      "shot": false
    },
    {
      "id": "e2-wire-l",
      "do": "click",
      "title": "E2: diagonal end point: an L-shaped wire sent as ONE Batch",
      "selector": "section[aria-label=\"Schematic view\"] svg.canvas",
      "dx": -80,
      "dy": -60,
      "expect": "footer.status span.msg",
      "expectText": "Batch"
    },
    {
      "id": "e2-wire-count",
      "do": "count",
      "title": "E2: the L-wire is two wire segments",
      "selector": "section[aria-label=\"Schematic view\"] line.wire:not(.preview)",
      "equals": 2,
      "shot": false
    },
    {
      "id": "e2-wire-esc",
      "do": "key",
      "title": "E2: Esc ends the wire tool's draft",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "e2-undo",
      "do": "menu",
      "title": "E2: one Undo removes both legs (one undo step)",
      "menu": "Edit",
      "item": "Undo"
    },
    {
      "id": "e2-undo-count",
      "do": "count",
      "title": "E2: no wire left after one undo",
      "selector": "section[aria-label=\"Schematic view\"] line.wire:not(.preview)",
      "equals": 0,
      "shot": false
    },
    {
      "id": "fx-esc",
      "do": "key",
      "title": "FX: Esc returns to the Select tool",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "fx-deselect",
      "do": "menu",
      "title": "FX: Edit › Clear selection",
      "menu": "Edit",
      "item": "Clear selection",
      "shot": false
    },
    {
      "id": "fx-no-selbar",
      "do": "absent",
      "title": "FX: no selection bar while nothing is selected",
      "selector": "section[aria-label=\"Schematic view\"] [role=\"group\"][aria-label=\"Selection\"]"
    },
    {
      "id": "fx-canvas-before",
      "do": "rect",
      "title": "FX: canvas position with nothing selected",
      "selector": "section[aria-label=\"Schematic view\"] svg.canvas",
      "save": "canvas",
      "shot": false
    },
    {
      "id": "fx-select",
      "do": "click",
      "title": "FX: select the part (selection bar appears)",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"group\"][aria-label=\"Selection\"]"
    },
    {
      "id": "fx-canvas-after",
      "do": "rect",
      "title": "FX: the canvas did not move when the selection bar appeared",
      "selector": "section[aria-label=\"Schematic view\"] svg.canvas",
      "same": "canvas",
      "shot": false
    },
    {
      "id": "fx-menu-place",
      "do": "menu",
      "title": "FX: Place › Place part arms Place",
      "menu": "Place",
      "item": "Place part",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "Place"
    },
    {
      "id": "fx-menu-wire",
      "do": "menu",
      "title": "FX: with Place armed, Place › Wire switches to Wire",
      "menu": "Place",
      "item": "Wire",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "Wire"
    },
    {
      "id": "fx-menu-nc",
      "do": "menu",
      "title": "FX: Place › No connect switches to No connect",
      "menu": "Place",
      "item": "No connect",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "No connect"
    },
    {
      "id": "fx-menu-label",
      "do": "menu",
      "title": "FX: Place › Net / power label switches to Label",
      "menu": "Place",
      "item": "Net / power label",
      "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]",
      "expectText": "Label"
    },
    {
      "id": "fx-esc-end",
      "do": "key",
      "title": "FX: Esc back to Select",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "a5-label-tool",
      "do": "menu",
      "title": "A5: Place › Net / power label: the inspector shows the Label tool's options",
      "menu": "Place",
      "item": "Net / power label",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"tool\"] input[aria-label=\"Net name\"]"
    },
    {
      "id": "a5-label-strip",
      "do": "absent",
      "title": "A5: the option is not duplicated in the editor's strip",
      "selector": "section[aria-label=\"Schematic view\"] input[aria-label=\"Net name\"]",
      "shot": false
    },
    {
      "id": "a5-label-esc",
      "do": "key",
      "title": "A5: Esc back to Select",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "a5-select",
      "do": "click",
      "title": "A5: select the part: the inspector shows its fields",
      "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"selection\"] input[aria-label=\"Value\"]"
    },
    {
      "id": "a5-value",
      "do": "type",
      "title": "A5: type into the inspector's Value field",
      "selector": "section[aria-label=\"Properties\"] input[aria-label=\"Value\"]",
      "value": "7",
      "shot": false
    },
    {
      "id": "a5-value-commit",
      "do": "key",
      "title": "A5: Enter commits the value as one SetSymbolValue",
      "keys": "Return",
      "expect": "footer.status span.msg",
      "expectText": "SetSymbolValue"
    },
    {
      "id": "a5-esc",
      "do": "key",
      "title": "A5: Esc clears the canvas selection (Edit › Clear selection clears the workspace selection)",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "a5-clear",
      "do": "menu",
      "title": "A5: Edit › Clear selection: the inspector shows the document (sheet size)",
      "menu": "Edit",
      "item": "Clear selection",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"document\"] [data-field=\"size\"]"
    },
    {
      "id": "a5-title-block",
      "do": "wait",
      "title": "A5: the title block is shown as unavailable (IR v3, B1), not as a control",
      "selector": "section[aria-label=\"Properties\"] [data-field=\"title-block\"] .unavail",
      "text": "Unavailable",
      "shot": false
    },
    {
      "id": "a5-menu-rest",
      "do": "key",
      "title": "A5: Esc returns the menu bar to rest before the next menu",
      "keys": "Escape",
      "shot": false
    },
    {
      "id": "pcb",
      "do": "menu",
      "title": "Open PCB",
      "menu": "View",
      "item": "Go to PCB editor",
      "expect": "section[aria-label=\"PCB view\"]"
    },
    {
      "id": "e2-layer-count",
      "do": "count",
      "title": "E2: PCB layer-count select offers 2..16 (8 options, was 2/4/6/8)",
      "selector": "select[aria-label=\"Copper layers\"] option",
      "equals": 8
    },
    {
      "id": "a5-pcb-props",
      "do": "click",
      "title": "A5: PCB right dock › Properties tab",
      "selector": "[role=\"tablist\"][aria-label=\"Right panel tabs\"] [role=\"tab\"]",
      "text": "Properties",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"document\"] [data-field=\"stackup\"]"
    },
    {
      "id": "a5-route",
      "do": "click",
      "title": "A5: Route tool: the inspector shows the routing options",
      "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button",
      "text": "Route",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"tool\"] input[aria-label=\"Track width\"]"
    },
    {
      "id": "a5-route-strip",
      "do": "absent",
      "title": "A5: the strip keeps the route actions, not the options",
      "selector": "section[aria-label=\"PCB view\"] input[aria-label=\"Track width\"]",
      "shot": false
    },
    {
      "id": "a5-route-off",
      "do": "click",
      "title": "A5: Select tool: the inspector leaves the tool options",
      "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button",
      "text": "Select",
      "expect": "section[aria-label=\"Properties\"]:not([data-mode=\"tool\"])"
    }
  ]
}
