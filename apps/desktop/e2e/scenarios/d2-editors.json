{
  "name": "D2 symbol and footprint editors",
  "description": "Opens an isolated software fixture project whose board outline (40 x 30 mm) is set by SETUP through the execute IPC. Then, with real X input (Phase 1 D2): Library tab › New part… creates a part (UpsertComponentDefinition) and opens its symbol editor document drawn by the A4 Canvas2D renderer; the footprint editor adds a pad and widens the courtyard, saved with AssignComponentFootprint; the symbol editor adds a pin (mapped to the new pad), renames it in the pin table and saves with UpsertComponentDefinition. The part is then placed on the schematic, the PCB is updated from the schematic, auto-placed, DRC reports no errors in implemented checks, and the manufacturing export writes files (labelled DRAFT by the engine unless every gate passes). Per-pad mask/paste expansion is shown as not available (no IR field).",
  "steps": [
    { "id": "home", "do": "wait", "title": "Project Home visible", "selector": "main.home h1", "timeout": 60000 },
    { "id": "fixture", "do": "fixture-project", "title": "Create fixture project", "name": "D2 Editors Fixture", "folder": "d2-editors-fixture" },
    {
      "id": "fixture-board",
      "do": "fixture-command",
      "title": "Fixture board outline 40 x 30 mm",
      "shot": false,
      "command": { "type": "SetBoardOutline", "points": [{ "x": 0, "y": 0 }, { "x": 40000000, "y": 0 }, { "x": 40000000, "y": 30000000 }, { "x": 0, "y": 30000000 }] }
    },
    { "id": "open", "do": "click", "title": "Open fixture from Recent projects", "selector": "button.home-row", "text": "D2 Editors Fixture", "expect": "nav[aria-label=\"Application menu\"]" },
    { "id": "sch", "do": "menu", "title": "Open schematic", "menu": "View", "item": "Go to Schematic editor", "expect": "section[aria-label=\"Schematic view\"]", "shot": false },
    { "id": "d2-library", "do": "click", "title": "D2: Library tab of the bottom dock", "selector": "section[aria-label=\"Bottom panel\"] [role=\"tab\"]", "text": "Library", "expect": "section[aria-label=\"Library dock\"]", "shot": false },
    { "id": "d2-manage", "do": "click", "title": "D2: Manage mode of the Library dock (project library, New part…)", "selector": "section[aria-label=\"Library dock\"] [role=\"tablist\"][aria-label=\"Library modes\"] button[role=\"tab\"]", "text": "Manage", "expect": "details.new-part > summary", "shot": false },
    { "id": "d2-new", "do": "click", "title": "D2: New part… opens the form", "selector": "details.new-part > summary", "expect": "input[aria-label=\"New part id\"]" },
    { "id": "d2-new-id", "do": "type", "title": "D2: part id", "selector": "input[aria-label=\"New part id\"]", "value": "D2_SENSOR", "shot": false },
    { "id": "d2-new-name", "do": "type", "title": "D2: part name", "selector": "input[aria-label=\"New part name\"]", "value": "D2 sensor", "shot": false },
    {
      "id": "d2-create",
      "do": "click",
      "title": "D2: Create part (UpsertComponentDefinition) opens the symbol editor document",
      "selector": "details.new-part button.primary",
      "text": "Create part",
      "expect": "section[aria-label=\"Symbol editor D2_SENSOR\"]"
    },
    { "id": "d2-sym-canvas", "do": "wait", "title": "D2: the symbol is drawn by the Canvas2D renderer (B1 rectangle and pins)", "selector": "section[aria-label=\"Symbol editor D2_SENSOR\"] canvas[data-draw=\"drawn\"]" },
    { "id": "d2-pin-table", "do": "count", "title": "D2: the pin table lists the two starting pins", "selector": "section[aria-label=\"Symbol editor D2_SENSOR\"] table[aria-label=\"Pins\"] tbody tr", "equals": 2, "shot": false },
    { "id": "d2-library-2", "do": "click", "title": "D2: Library tab again (a part editor has its own dock layout)", "selector": "section[aria-label=\"Bottom panel\"] [role=\"tab\"]", "text": "Library", "expect": "section[aria-label=\"Library dock\"]", "shot": false },
    { "id": "d2-manage-2", "do": "click", "title": "D2: Manage mode of the Library dock (project library, New part…)", "selector": "section[aria-label=\"Library dock\"] [role=\"tablist\"][aria-label=\"Library modes\"] button[role=\"tab\"]", "text": "Manage", "expect": "input[aria-label=\"Search library\"]", "shot": false },
    { "id": "d2-search", "do": "type", "title": "D2: the new part is in the library search", "selector": "input[aria-label=\"Search library\"]", "value": "D2_SENSOR", "expect": "ul[aria-label=\"Library parts\"] button", "expectText": "D2 sensor", "shot": false },
    { "id": "d2-select", "do": "click", "title": "D2: select it", "selector": "ul[aria-label=\"Library parts\"] button", "text": "D2 sensor", "expect": "section.lib-detail button", "expectText": "Edit footprint", "shot": false },
    { "id": "d2-edit-fp", "do": "click", "title": "D2: Edit footprint opens the footprint editor document", "selector": "section.lib-detail button", "text": "Edit footprint", "expect": "section[aria-label=\"Footprint editor D2_SENSOR\"] table[aria-label=\"Pads\"]" },
    { "id": "d2-fp-canvas", "do": "wait", "title": "D2: pads and courtyard drawn by the Canvas2D renderer", "selector": "section[aria-label=\"Footprint editor D2_SENSOR\"] canvas[data-draw=\"drawn\"]", "shot": false },
    { "id": "d2-mask", "do": "wait", "title": "D2: per-pad mask/paste expansion shown as not available (no IR field), not as a control", "selector": "section[aria-label=\"Footprint editor D2_SENSOR\"] p[data-unavailable=\"mask-paste\"]", "shot": false },
    { "id": "d2-add-pad", "do": "click", "title": "D2: Add pad", "selector": "section[aria-label=\"Footprint editor D2_SENSOR\"] button", "text": "Add pad", "expect": "section[aria-label=\"Footprint editor D2_SENSOR\"] tr[data-pad=\"3\"]" },
    { "id": "d2-court-click", "do": "click", "title": "D2: courtyard half width field", "selector": "input[aria-label=\"Courtyard half width\"]", "shot": false },
    { "id": "d2-court-all", "do": "key", "title": "D2: select the field text", "keys": "ctrl+a", "shot": false },
    { "id": "d2-court-type", "do": "type", "title": "D2: courtyard half width 5 mm", "value": "5", "shot": false },
    { "id": "d2-court-enter", "do": "key", "title": "D2: Enter commits the courtyard", "keys": "Return", "expect": "section[aria-label=\"Footprint editor D2_SENSOR\"][data-dirty=\"true\"]" },
    {
      "id": "d2-fp-save",
      "do": "click",
      "title": "D2: Save the footprint (AssignComponentFootprint)",
      "selector": "section[aria-label=\"Footprint editor D2_SENSOR\"] .pe-head button.primary",
      "text": "Save",
      "expect": "footer.status span.msg",
      "expectText": "AssignComponentFootprint"
    },
    { "id": "d2-fp-clean", "do": "wait", "title": "D2: the footprint editor matches the project library after the save", "selector": "section[aria-label=\"Footprint editor D2_SENSOR\"][data-dirty=\"false\"]", "shot": false },
    { "id": "d2-sym-tab", "do": "click", "title": "D2: back to the symbol editor tab", "selector": "[role=\"tablist\"][aria-label=\"Documents\"] button[role=\"tab\"]", "text": "Symbol: D2_SENSOR", "expect": "section[aria-label=\"Symbol editor D2_SENSOR\"] table[aria-label=\"Pins\"]", "shot": false },
    { "id": "d2-add-pin", "do": "click", "title": "D2: Add pin (mapped to the new pad 3)", "selector": "section[aria-label=\"Symbol editor D2_SENSOR\"] button", "text": "Add pin", "expect": "input[aria-label=\"Pin 3 pads\"]" },
    { "id": "d2-pin-click", "do": "click", "title": "D2: pin 3 name field", "selector": "input[aria-label=\"Pin 3 name\"]", "shot": false },
    { "id": "d2-pin-all", "do": "key", "title": "D2: select the field text", "keys": "ctrl+a", "shot": false },
    { "id": "d2-pin-type", "do": "type", "title": "D2: name pin 3 SENSE", "value": "SENSE", "shot": false },
    { "id": "d2-pin-enter", "do": "key", "title": "D2: Enter commits the pin name", "keys": "Return", "expect": "section[aria-label=\"Symbol editor D2_SENSOR\"][data-dirty=\"true\"]" },
    {
      "id": "d2-sym-save",
      "do": "click",
      "title": "D2: Save the symbol (UpsertComponentDefinition)",
      "selector": "section[aria-label=\"Symbol editor D2_SENSOR\"] .pe-head button.primary",
      "text": "Save",
      "expect": "footer.status span.msg",
      "expectText": "UpsertComponentDefinition"
    },
    { "id": "d2-sym-clean", "do": "wait", "title": "D2: the symbol editor matches the project library after the save", "selector": "section[aria-label=\"Symbol editor D2_SENSOR\"][data-dirty=\"false\"]", "shot": false },
    { "id": "d2-place-arm", "do": "click", "title": "D2: Place on schematic arms the Place tool with the new part", "selector": "section.lib-detail button.primary", "text": "Place on schematic", "expect": "footer.status span.msg", "expectText": "Place tool armed with D2 sensor" },
    { "id": "d2-place", "do": "click", "title": "D2: click the sheet places the part (PlaceSymbol)", "selector": "[role=\"img\"][aria-label=\"Schematic canvas\"]", "expect": "footer.status span.msg", "expectText": "PlaceSymbol" },
    { "id": "d2-placed", "do": "count", "title": "D2: one symbol on the sheet", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]", "equals": 1 },
    { "id": "d2-sync", "do": "menu", "title": "D2: Design › Update PCB from schematic opens the review of the changes", "menu": "Design", "item": "Update PCB from schematic", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] table[aria-label=\"Changes to apply\"]", "timeout": 60000 },
    { "id": "d2-sync-apply", "do": "click", "title": "D2: Apply changes runs the sync (C2 review dialog)", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button.primary", "text": "Apply changes", "expect": "[role=\"dialog\"][aria-label=\"Update PCB report\"]", "gone": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"]" },
    { "id": "d2-sync-close", "do": "key", "title": "D2: close the report", "keys": "Escape", "gone": "[role=\"dialog\"][aria-label=\"Update PCB report\"]", "shot": false },
    { "id": "d2-pcb", "do": "menu", "title": "D2: open the PCB", "menu": "View", "item": "Go to PCB editor", "expect": "section[aria-label=\"PCB view\"]", "shot": false },
    { "id": "d2-autoplace", "do": "menu", "title": "D2: Design › Auto-place footprints puts it on the fixture board", "menu": "Design", "item": "Auto-place footprints", "expect": "footer.status span.msg", "expectText": "AutoPlace" },
    { "id": "d2-drc", "do": "menu", "title": "D2: Design › Run DRC: no errors in implemented checks", "menu": "Design", "item": "Run DRC", "expect": "section[aria-label=\"DRC report\"] p", "expectText": "No errors in implemented checks", "timeout": 60000 },
    { "id": "d2-export-open", "do": "menu", "title": "D2: Manufacturing › Export manufacturing files…", "menu": "Manufacturing", "item": "Export manufacturing files", "expect": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"]", "shot": false },
    { "id": "d2-export", "do": "click", "title": "D2: Export writes the files (status as the engine words it)", "selector": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"] button.primary", "text": "Export", "expect": "ul[aria-label=\"Exported files\"] li", "timeout": 120000 }
  ]
}
