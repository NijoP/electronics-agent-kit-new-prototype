{
  "name": "C2 ECO preview for Update PCB",
  "description": "Slice C2 (ADR-0041): the toolbar's Update PCB opens a review of the engine's read-only sync preview instead of applying the sync directly. On an isolated software fixture with one placed part, the dialog lists the footprint to add; unchecking it disables Apply with the reason shown (selective apply is not available yet) and nothing is applied; Export report saves the engine's preview as evidence; checked again, Apply sends the sync as one Batch and the Update PCB report shows what the engine added. A second Update PCB then finds nothing to change.",
  "steps": [
    { "id": "home", "do": "wait", "title": "Project Home visible", "selector": "main.home h1", "timeout": 60000 },
    { "id": "fixture", "do": "fixture-project", "title": "Create fixture project", "name": "C2 ECO Fixture", "folder": "c2-eco-fixture" },
    { "id": "open", "do": "click", "title": "Open fixture from Recent projects", "selector": "button.home-row", "text": "C2 ECO Fixture", "expect": "nav[aria-label=\"Application menu\"]" },
    { "id": "sch", "do": "menu", "title": "Open schematic", "menu": "View", "item": "Go to Schematic editor", "expect": "section[aria-label=\"Schematic view\"]", "shot": false },
    { "id": "c2-place-tool", "do": "click", "title": "C2: Place tool", "shot": false, "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button", "text": "Place", "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]", "expectText": "Place" },
    { "id": "c2-place", "do": "click", "title": "C2: place one part (PlaceSymbol accepted)", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "expect": "footer.status span.msg", "expectText": "PlaceSymbol" },
    { "id": "c2-esc", "do": "key", "title": "C2: leave the Place tool", "keys": "Escape", "shot": false },
    { "id": "c2-open", "do": "click", "title": "C2: toolbar Update PCB opens the review dialog (nothing applied yet)", "selector": "button.tb-btn[aria-label=\"Update PCB\"]", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] table[aria-label=\"Changes to apply\"]" },
    { "id": "c2-rows", "do": "count", "title": "C2: one change listed (the footprint to add)", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] tr[data-eco-row]", "equals": 1 },
    { "id": "c2-uncheck", "do": "click", "title": "C2: uncheck the change: Apply is refused with the reason", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] tr[data-eco-row] input[type=\"checkbox\"]", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] p.eco-reason", "expectText": "1 change(s) unchecked" },
    { "id": "c2-apply-off", "do": "wait", "title": "C2: Apply changes is disabled while a change is unchecked", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button.primary[disabled]", "text": "Apply changes", "shot": false },
    { "id": "c2-export", "do": "click", "title": "C2: Export report saves the engine's preview as evidence", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button", "text": "Export report", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] p", "expectText": "Report saved:" },
    { "id": "c2-recheck", "do": "click", "title": "C2: check the change again", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] tr[data-eco-row] input[type=\"checkbox\"]", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button.primary:not([disabled])", "expectText": "Apply changes", "shot": false },
    { "id": "c2-apply", "do": "click", "title": "C2: Apply changes runs the sync as one Batch; the report lists the added footprint", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button.primary", "text": "Apply changes", "expect": "[role=\"dialog\"][aria-label=\"Update PCB report\"] section[aria-label=\"Components added\"] li", "gone": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"]" },
    { "id": "c2-report-esc", "do": "key", "title": "C2: Escape closes the report", "keys": "Escape", "gone": "[role=\"dialog\"][aria-label=\"Update PCB report\"]", "shot": false },
    { "id": "c2-insync", "do": "click", "title": "C2: Update PCB again: the PCB already matches, nothing to review", "selector": "button.tb-btn[aria-label=\"Update PCB\"]", "expect": "[role=\"dialog\"][aria-label=\"Update PCB report\"] p", "expectText": "The PCB already matches" }
  ]
}
