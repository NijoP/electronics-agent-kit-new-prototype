{
  "name": "B3 follow-ups: groups and net-label rename",
  "description": "ADR-0045 (IR schema v6). A fixture project gets two resistors and a VIN net label through the engine's execute_command IPC (SETUP). In the real window the Inspector renames the label with one RenameNetLabel (the label stays one object). Ctrl+A and Edit > Group make one Group command; afterwards a click on one part selects the whole group, and the canvas context menu offers Ungroup. Ctrl+Shift+G ungroups (one Ungroup command): a click then selects one part again. One Undo restores the group: a click selects the whole group again.",
  "steps": [
    { "id": "home", "do": "wait", "title": "Project Home visible", "selector": "main.home h1", "timeout": 60000 },
    { "id": "fixture", "do": "fixture-project", "title": "Create fixture project (schema v6)", "name": "B3 Groups Fixture", "folder": "b3-groups-fixture" },
    { "id": "open", "do": "click", "title": "Open fixture from Recent projects", "selector": "button.home-row", "text": "B3 Groups Fixture", "expect": "nav[aria-label=\"Application menu\"]" },
    { "id": "sch", "do": "menu", "title": "Open schematic", "menu": "View", "item": "Go to Schematic editor", "expect": "section[aria-label=\"Schematic view\"]" },
    {
      "id": "g-setup",
      "do": "fixture-commands",
      "title": "Groups: two resistors and a VIN net label (engine commands)",
      "commands": [
        { "type": "PlaceSymbol", "sheet_id": null, "component_id": "R_0603", "position": { "x": 100000000, "y": 120000000 }, "rotation": "R0", "refdes": null, "value": null },
        { "type": "PlaceSymbol", "sheet_id": null, "component_id": "R_0603", "position": { "x": 180000000, "y": 120000000 }, "rotation": "R0", "refdes": null, "value": null },
        { "type": "AddNetLabel", "sheet_id": null, "name": "VIN", "position": { "x": 140000000, "y": 70000000 }, "kind": "net" }
      ],
      "expect": "section[aria-label=\"Schematic view\"] g[data-label-id] text",
      "expectText": "VIN"
    },
    { "id": "g-two", "do": "count", "title": "Groups: two parts on the sheet", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]", "equals": 2, "shot": false },
    { "id": "g-props-tab", "do": "click", "title": "Groups: the right dock's Properties tab", "selector": "aside.right-dock [role=\"tab\"]", "text": "Properties", "expect": "section[aria-label=\"Properties\"]", "shot": false },
    { "id": "g-find-open", "do": "key", "title": "Rename: Ctrl+F opens Find and replace (the label is a few pixels tall at this zoom, so it is selected by name)", "keys": "ctrl+f", "expect": "[role=\"search\"][aria-label=\"Find and replace\"] input[aria-label=\"Find\"]", "shot": false },
    { "id": "g-find-type", "do": "type", "title": "Rename: find VIN", "selector": "[role=\"search\"][aria-label=\"Find and replace\"] input[aria-label=\"Find\"]", "value": "VIN", "shot": false },
    { "id": "g-label-select", "do": "click", "title": "Rename: Select matches selects the net label; the Inspector shows its net name", "selector": "[role=\"search\"][aria-label=\"Find and replace\"] button", "text": "Select matches", "expect": "section[aria-label=\"Properties\"][data-mode=\"selection\"] input[aria-label=\"Net name\"]" },
    { "id": "g-find-close", "do": "click", "title": "Rename: close Find and replace (the selection stays)", "selector": "[role=\"search\"][aria-label=\"Find and replace\"] button[aria-label=\"Close find and replace\"]", "gone": "[role=\"search\"][aria-label=\"Find and replace\"]", "shot": false },
    { "id": "g-label-field", "do": "click", "title": "Rename: focus the Net name field", "selector": "section[aria-label=\"Properties\"] input[aria-label=\"Net name\"]", "shot": false },
    { "id": "g-label-all", "do": "key", "title": "Rename: select the field's text", "keys": "ctrl+a", "shot": false },
    { "id": "g-label-type", "do": "type", "title": "Rename: type the new net name", "value": "VBAT", "shot": false },
    { "id": "g-label-commit", "do": "key", "title": "Rename: Enter commits one RenameNetLabel (no delete + add)", "keys": "Return", "expect": "footer.status span.msg", "expectText": "RenameNetLabel" },
    { "id": "g-label-drawn", "do": "wait", "title": "Rename: the sheet draws the label as VBAT", "selector": "section[aria-label=\"Schematic view\"] g[data-label-id] text", "text": "VBAT", "shot": false },
    { "id": "g-label-one", "do": "count", "title": "Rename: still exactly one label (renamed in place)", "selector": "section[aria-label=\"Schematic view\"] g[data-label-id]", "equals": 1, "shot": false },
    { "id": "g-focus", "do": "click", "title": "Groups: click the empty sheet (clears the selection, focuses the canvas)", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": 0, "dy": -200, "shot": false },
    { "id": "g-select-all", "do": "key", "title": "Groups: Ctrl+A selects both parts and the label", "keys": "ctrl+a", "shot": false },
    { "id": "g-selected", "do": "count", "title": "Groups: two parts selected", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id].selected", "equals": 2, "shot": false },
    { "id": "g-group", "do": "menu", "title": "Groups: Edit > Group makes one Group command", "menu": "Edit", "item": "Group", "expect": "footer.status span.msg", "expectText": "Group" },
    { "id": "g-clear", "do": "click", "title": "Groups: click the empty sheet clears the selection", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": 0, "dy": -200, "shot": false },
    { "id": "g-none", "do": "count", "title": "Groups: nothing selected", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id].selected", "equals": 0, "shot": false },
    { "id": "g-pick", "do": "click", "title": "Groups: a click on one part selects the whole group", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body" },
    { "id": "g-pick-parts", "do": "count", "title": "Groups: both parts selected", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id].selected", "equals": 2, "shot": false },
    { "id": "g-pick-label", "do": "count", "title": "Groups: the label is selected with them", "selector": "section[aria-label=\"Schematic view\"] g[data-label-id].selected", "equals": 1, "shot": false },
    { "id": "g-ctx", "do": "click", "button": "right", "title": "Groups: right-click the part; the context menu offers Ungroup", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body", "expect": "ul.canvas-ctx[role=\"menu\"] button[role=\"menuitem\"]:not([disabled])", "expectText": "Ungroup" },
    { "id": "g-ctx-close", "do": "key", "title": "Groups: Escape closes the context menu", "keys": "Escape", "gone": "ul.canvas-ctx[role=\"menu\"]", "shot": false },
    { "id": "g-reselect", "do": "click", "title": "Groups: select the group again", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body", "shot": false },
    { "id": "g-ungroup", "do": "key", "title": "Groups: Ctrl+Shift+G makes one Ungroup command", "keys": "ctrl+shift+g", "expect": "footer.status span.msg", "expectText": "Ungroup" },
    { "id": "g-clear-2", "do": "click", "title": "Groups: clear the selection", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": 0, "dy": -200, "shot": false },
    { "id": "g-pick-2", "do": "click", "title": "Groups: after Ungroup a click selects one part", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body", "shot": false },
    { "id": "g-one", "do": "count", "title": "Groups: one part selected", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id].selected", "equals": 1 },
    { "id": "g-undo", "do": "menu", "title": "Groups: one Undo restores the group (one undo step)", "menu": "Edit", "item": "Undo", "shot": false },
    { "id": "g-clear-3", "do": "click", "title": "Groups: clear the selection", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": 0, "dy": -200, "shot": false },
    { "id": "g-pick-3", "do": "click", "title": "Groups: a click selects the whole group again", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id] rect.body", "shot": false },
    { "id": "g-regrouped", "do": "count", "title": "Groups: both parts selected after one Undo", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id].selected", "equals": 2 }
  ]
}
