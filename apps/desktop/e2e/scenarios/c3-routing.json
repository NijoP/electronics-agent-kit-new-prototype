{
  "name": "C3 routing options",
  "description": "Slice C3 (routing experience) and ADR-0044 (saved routing options): the fixture board carries saved routing options (SetRoutingOptions as SETUP) and the Route tool opens with them selected. with the Route tool active, the right dock's inspector shows the routing options: width presets from the net classes, the via preset, 45/90 corners with arc corners marked unavailable, the obstacle mode (walk around, push or block), loop removal, the ratsnest toggle and the live net-length readout.",
  "steps": [
    {
      "id": "home",
      "do": "wait",
      "title": "Project Home visible",
      "selector": "main.home h1",
      "timeout": 60000
    },
    {
      "id": "fixture",
      "do": "fixture-project",
      "title": "Create fixture project",
      "name": "C3 Routing Fixture",
      "folder": "c3-routing-fixture"
    },
    {
      "id": "v5-saved-options",
      "do": "fixture-command",
      "title": "Fixture: routing options saved with the board (SetRoutingOptions, schema v5, ADR-0044)",
      "shot": false,
      "command": { "type": "SetRoutingOptions", "options": { "bend": "orthogonal90", "conflict": "push", "width": 400000, "via": null, "remove_loops": false } }
    },
    {
      "id": "open",
      "do": "click",
      "title": "Open fixture from Recent projects",
      "selector": "button.home-row",
      "text": "C3 Routing Fixture",
      "expect": "nav[aria-label=\"Application menu\"]"
    },
    {
      "id": "pcb",
      "do": "menu",
      "title": "Open PCB",
      "menu": "View",
      "item": "Go to PCB editor",
      "expect": "section[aria-label=\"PCB view\"]"
    },
    {
      "id": "props",
      "do": "click",
      "title": "PCB right dock › Properties tab",
      "selector": "[role=\"tablist\"][aria-label=\"Right panel tabs\"] [role=\"tab\"]",
      "text": "Properties",
      "expect": "section[aria-label=\"Properties\"]"
    },
    {
      "id": "c3-route",
      "do": "click",
      "title": "C3: Route tool: the inspector shows the width preset",
      "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button",
      "text": "Route",
      "expect": "section[aria-label=\"Properties\"][data-mode=\"tool\"] select[aria-label=\"Width preset\"]"
    },
    {
      "id": "c3-via-preset",
      "do": "wait",
      "title": "C3: via preset select",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Via preset\"]",
      "shot": false
    },
    {
      "id": "c3-obstacles",
      "do": "count",
      "title": "C3: obstacle mode offers walk around, push and block",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Obstacle mode\"] option",
      "equals": 3,
      "shot": false
    },
    {
      "id": "c3-push-offered",
      "do": "count",
      "title": "C3: push (shove tracks) is offered as an obstacle mode",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Obstacle mode\"] option[value=\"push\"]",
      "equals": 1,
      "shot": false
    },
    {
      "id": "v5-saved-obstacle",
      "do": "count",
      "title": "ADR-0044: the Route tool opens with the board's saved obstacle mode (push) selected",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Obstacle mode\"] option[value=\"push\"]:checked",
      "equals": 1
    },
    {
      "id": "v5-saved-corners",
      "do": "count",
      "title": "ADR-0044: saved 90-degree corners are selected",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Bend mode\"] option[value=\"orthogonal90\"]:checked",
      "equals": 1,
      "shot": false
    },
    {
      "id": "v5-saved-loops",
      "do": "count",
      "title": "ADR-0044: saved loop removal (off) is selected",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Remove loops\"] option[value=\"off\"]:checked",
      "equals": 1,
      "shot": false
    },
    {
      "id": "c3-arc-unavailable",
      "do": "wait",
      "title": "C3: arc corners are marked unavailable",
      "selector": "section[aria-label=\"Properties\"] [data-field=\"Arc corners\"] .unavail",
      "text": "Unavailable",
      "shot": false
    },
    {
      "id": "c3-loops",
      "do": "count",
      "title": "C3: loop removal on/off",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Remove loops\"] option",
      "equals": 2,
      "shot": false
    },
    {
      "id": "c3-ratsnest",
      "do": "count",
      "title": "C3: ratsnest shown/hidden",
      "selector": "section[aria-label=\"Properties\"] select[aria-label=\"Ratsnest\"] option",
      "equals": 2,
      "shot": false
    },
    {
      "id": "c3-net-length",
      "do": "wait",
      "title": "C3: live net-length readout",
      "selector": "section[aria-label=\"Properties\"] [data-field=\"Net length\"]"
    }
  ]
}
