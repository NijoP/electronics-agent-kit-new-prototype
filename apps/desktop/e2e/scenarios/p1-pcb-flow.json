{
  "name": "P1 PCB workflow (F6)",
  "description": "Phase 1 definition-of-done F6: the PCB workflow from an empty app, every step by real X input and no SETUP. Project Home's New Project opens the native GTK folder chooser, which is cancelled with Escape (picking a folder in it is not deterministic under Xvfb: it opens on Recent with Open disabled), and the parent folder is typed into the form instead; the File > New project dialog then creates the flow project next to it (both stay open as project tabs, as the corrected hint says). In the schematic two resistors are placed and wired into two nets, and Design > Run ERC runs. In the PCB editor (SVG renderer, so pads are DOM elements a click can target) the board outline is drawn with the Outline tool, Update PCB applies the review dialog and Auto-place puts both footprints on the board (two airwires). One net is routed with clicks: start on R1 pad 2, a point, L (bottom layer, a via), a point, L (top again, a second via), end on R2 pad 1: one Batch with two vias. Auto-route routes the other net (no airwires left); Clear all routing (its native confirm accepted) removes every track and via and one Undo brings them back. A copper zone is drawn and filled by the engine, Refill zones recomputes it, Run DRC reports, the manufacturing export writes files, and Release check shows the status DRAFT with its blocking reasons. The outline is drawn before Update PCB: AutoPlace needs an outline, and before one exists the view is framed on the default 100 x 80 mm area.",
  "steps": [
    { "id": "home", "do": "wait", "title": "Project Home visible", "selector": "main.home h1", "timeout": 60000 },
    { "id": "f6-home-new", "do": "click", "title": "F6: Project Home › New Project opens the create form", "selector": "section[aria-label=\"Start\"] button", "text": "New Project", "expect": "form[aria-label=\"Create project\"]" },
    { "id": "f6-home-name", "do": "type", "title": "F6: project name", "shot": false, "selector": "form[aria-label=\"Create project\"] input", "value": "F6 Home Project" },
    { "id": "f6-home-choose", "do": "click", "title": "F6: Choose parent folder… opens the native folder chooser", "shot": false, "selector": "form[aria-label=\"Create project\"] button", "text": "Choose parent folder" },
    { "id": "f6-home-native", "do": "native-dialog", "title": "F6: the native GTK folder chooser opens (screenshot) and Escape cancels it (picking a folder in it is not deterministic under Xvfb)", "window": "Choose where the new project folder is created", "keys": "Escape" },
    { "id": "f6-home-cancelled", "do": "wait", "title": "F6: cancelling the chooser leaves no folder chosen: Create stays disabled", "shot": false, "selector": "form[aria-label=\"Create project\"] button.primary[disabled]", "text": "Create" },
    { "id": "f6-home-folder", "do": "type", "title": "F6: the parent folder typed into the form's Parent folder field", "selector": "input[aria-label=\"Parent folder\"]", "value": "{UI_OUT}", "expect": "form[aria-label=\"Create project\"] code" },
    { "id": "f6-home-create", "do": "click", "title": "F6: Create (create_project) opens the workspace", "selector": "form[aria-label=\"Create project\"] button.primary", "text": "Create", "expect": "nav[aria-label=\"Application menu\"]", "timeout": 30000 },
    { "id": "f6-new-dialog", "do": "menu", "title": "F6: File › New project… opens the New project dialog", "menu": "File", "item": "New project", "expect": "[role=\"dialog\"][aria-label=\"New project\"]" },
    { "id": "f6-new-hint", "do": "wait", "title": "F6: the dialog says the other open projects stay open (it no longer claims the current one closes)", "selector": "[role=\"dialog\"][aria-label=\"New project\"] p.hint", "text": "Other open projects stay open" },
    { "id": "f6-new-path", "do": "type", "title": "F6: project folder (absolute path)", "shot": false, "selector": "form[aria-label=\"New project form\"] label:nth-of-type(1) input", "value": "{UI_OUT}/f6-pcb-flow" },
    { "id": "f6-new-name", "do": "type", "title": "F6: project name", "shot": false, "selector": "form[aria-label=\"New project form\"] label:nth-of-type(2) input", "value": "F6 PCB Flow" },
    { "id": "f6-new-create", "do": "click", "title": "F6: Create creates the flow project", "selector": "form[aria-label=\"New project form\"] button.primary", "text": "Create", "gone": "[role=\"dialog\"][aria-label=\"New project\"]", "timeout": 30000 },
    { "id": "f6-two-projects", "do": "count", "title": "F6: both projects are open (two project tabs)", "selector": "[role=\"tablist\"][aria-label=\"Open projects\"] [role=\"tab\"]", "equals": 2 },
    { "id": "f6-active", "do": "wait", "title": "F6: the new project is the active tab", "shot": false, "selector": "[role=\"tablist\"][aria-label=\"Open projects\"] [role=\"tab\"][aria-selected=\"true\"]", "text": "F6 PCB Flow" },

    { "id": "f6-sch", "do": "menu", "title": "F6: View › Go to Schematic editor", "shot": false, "menu": "View", "item": "Go to Schematic editor", "expect": "section[aria-label=\"Schematic view\"]" },
    { "id": "f6-place-tool", "do": "click", "title": "F6: Place tool", "shot": false, "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button", "text": "Place", "expect": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button[aria-pressed=\"true\"]", "expectText": "Place" },
    { "id": "f6-place-1", "do": "click", "title": "F6: place R1", "shot": false, "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": -160, "dy": -60, "expect": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R1\"]" },
    { "id": "f6-place-2", "do": "click", "title": "F6: place R2 lower and to the right", "selector": "section[aria-label=\"Schematic view\"] svg.canvas", "dx": 160, "dy": 60, "expect": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R2\"]" },
    { "id": "f6-two-parts", "do": "count", "title": "F6: two parts on the sheet", "shot": false, "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]", "equals": 2 },
    { "id": "f6-place-esc", "do": "key", "title": "F6: Escape leaves the Place tool", "shot": false, "keys": "Escape" },
    { "id": "f6-wire-tool", "do": "click", "title": "F6: Wire tool", "shot": false, "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button", "text": "Wire", "expect": "section[aria-label=\"Schematic view\"][data-tool=\"wire\"]" },
    { "id": "f6-wire-a1", "do": "click", "title": "F6: net A starts on R1 pin 2", "shot": false, "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R1\"] g[data-pin=\"2\"] circle.pin-end" },
    { "id": "f6-wire-a2", "do": "click", "title": "F6: net A ends on R2 pin 1 (AddWire)", "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R2\"] g[data-pin=\"1\"] circle.pin-end", "expect": "section[aria-label=\"Schematic view\"] line.wire:not(.preview)" },
    { "id": "f6-wire-a-esc", "do": "key", "title": "F6: Escape ends net A's wire", "shot": false, "keys": "Escape" },
    { "id": "f6-wire-tool-2", "do": "click", "title": "F6: Wire tool for net B", "shot": false, "selector": "section[aria-label=\"Schematic view\"] [role=\"toolbar\"][aria-label=\"Schematic tools\"] button", "text": "Wire", "expect": "section[aria-label=\"Schematic view\"][data-tool=\"wire\"]" },
    { "id": "f6-wire-b1", "do": "click", "title": "F6: net B starts on R1 pin 1", "shot": false, "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R1\"] g[data-pin=\"1\"] circle.pin-end" },
    { "id": "f6-wire-b2", "do": "click", "title": "F6: net B goes up, clear of both parts (inside the visible canvas)", "shot": false, "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R1\"] g[data-pin=\"1\"] circle.pin-end", "dy": -110 },
    { "id": "f6-wire-b3", "do": "click", "title": "F6: net B runs above R2 at the same height", "shot": false, "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R2\"] g[data-pin=\"2\"] circle.pin-end", "dy": -230 },
    { "id": "f6-wire-b4", "do": "click", "title": "F6: net B ends on R2 pin 2", "selector": "section[aria-label=\"Schematic view\"] g[data-refdes=\"R2\"] g[data-pin=\"2\"] circle.pin-end" },
    { "id": "f6-wire-b-esc", "do": "key", "title": "F6: Escape ends net B's wire", "shot": false, "keys": "Escape" },
    { "id": "f6-erc", "do": "menu", "title": "F6: Design › Run ERC fills the Findings tab", "menu": "Design", "item": "Run ERC", "expect": "section[aria-label=\"ERC report\"]", "timeout": 60000 },

    { "id": "f6-pcb", "do": "menu", "title": "F6: View › Go to PCB editor", "shot": false, "menu": "View", "item": "Go to PCB editor", "expect": "section[aria-label=\"PCB view\"]" },
    { "id": "f6-renderer-open", "do": "click", "title": "F6: the PCB renderer select", "shot": false, "selector": "select[aria-label=\"PCB renderer\"]" },
    { "id": "f6-renderer-down", "do": "key", "title": "F6: Down to SVG (fallback)", "shot": false, "keys": "Down" },
    { "id": "f6-renderer-pick", "do": "key", "title": "F6: Return picks it", "shot": false, "keys": "Return" },
    { "id": "f6-svg", "do": "absent", "title": "F6: the SVG renderer draws the board (no Canvas2D canvas), so pads are click targets", "selector": "section[aria-label=\"PCB view\"] canvas", "timeout": 5000 },
    { "id": "f6-outline-tool", "do": "click", "title": "F6: Board outline tool", "shot": false, "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button", "text": "Board outline", "expect": "section[aria-label=\"PCB view\"] button", "expectText": "Finish outline" },
    { "id": "f6-outline-1", "do": "click", "title": "F6: outline first corner", "shot": false, "selector": "section[aria-label=\"PCB view\"] svg[aria-label=\"PCB canvas\"]", "dx": -300, "dy": -105 },
    { "id": "f6-outline-2", "do": "click", "title": "F6: outline opposite corner", "selector": "section[aria-label=\"PCB view\"] svg[aria-label=\"PCB canvas\"]", "dx": 300, "dy": 105, "expect": "section[aria-label=\"PCB view\"] button", "expectText": "Finish outline (2 pts)" },
    { "id": "f6-outline-finish", "do": "click", "title": "F6: Finish outline sends SetBoardOutline", "selector": "section[aria-label=\"PCB view\"] button", "text": "Finish outline", "expect": "section[aria-label=\"PCB view\"] polygon.board" },
    { "id": "f6-sync", "do": "menu", "title": "F6: Design › Update PCB from schematic opens the review", "menu": "Design", "item": "Update PCB from schematic", "expect": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] table[aria-label=\"Changes to apply\"]", "timeout": 60000 },
    { "id": "f6-sync-apply", "do": "click", "title": "F6: Apply changes runs the sync", "selector": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"] button.primary", "text": "Apply changes", "expect": "[role=\"dialog\"][aria-label=\"Update PCB report\"]", "gone": "[role=\"dialog\"][aria-label=\"Update PCB: review changes\"]" },
    { "id": "f6-sync-close", "do": "key", "title": "F6: close the report", "shot": false, "keys": "Escape", "gone": "[role=\"dialog\"][aria-label=\"Update PCB report\"]" },
    { "id": "f6-autoplace", "do": "menu", "title": "F6: Design › Auto-place footprints puts both parts on the board", "menu": "Design", "item": "Auto-place footprints", "expect": "footer.status span.msg", "expectText": "AutoPlace" },
    { "id": "f6-placed", "do": "wait", "title": "F6: R1 and R2 are drawn with their pads", "shot": false, "selector": "section[aria-label=\"PCB view\"] g[data-refdes=\"R2\"] g[data-pad=\"1\"]" },
    { "id": "f6-airwires-2", "do": "count", "title": "F6: two airwires: the schematic's two nets, unrouted", "selector": "section[aria-label=\"PCB view\"] line.airwire", "equals": 2 },

    { "id": "f6-route-tool", "do": "click", "title": "F6: Route tool", "shot": false, "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button", "text": "Route", "expect": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button[aria-pressed=\"true\"]", "expectText": "Route" },
    { "id": "f6-route-start", "do": "click", "title": "F6: a click on R1 pad 2 starts the route of its net (F.Cu)", "selector": "section[aria-label=\"PCB view\"] g[data-refdes=\"R1\"] g[data-pad=\"2\"]", "expect": "section[aria-label=\"PCB view\"] circle.anchor" },
    { "id": "f6-route-p1", "do": "click", "title": "F6: a click below the pad fixes the engine's legal path there", "selector": "section[aria-label=\"PCB view\"] g[data-refdes=\"R1\"] g[data-pad=\"2\"]", "dy": 50, "expect": "section[aria-label=\"PCB view\"] line[data-route-preview=\"fixed\"]" },
    { "id": "f6-route-layer", "do": "key", "title": "F6: L changes to B.Cu mid-route (a via at the last point)", "keys": "l", "expect": "[role=\"tab\"][data-layer=\"bottom\"][aria-selected=\"true\"]" },
    { "id": "f6-route-p2", "do": "click", "title": "F6: a click below R2 pad 1: the via and a bottom-layer segment", "selector": "section[aria-label=\"PCB view\"] g[data-refdes=\"R2\"] g[data-pad=\"1\"]", "dy": 50, "expect": "section[aria-label=\"PCB view\"] circle.via.preview" },
    { "id": "f6-route-layer-2", "do": "key", "title": "F6: L changes back to F.Cu (a second via)", "keys": "l", "expect": "[role=\"tab\"][data-layer=\"top\"][aria-selected=\"true\"]" },
    { "id": "f6-route-end", "do": "click", "title": "F6: a click on R2 pad 1 ends the route on its net: one Batch", "selector": "section[aria-label=\"PCB view\"] g[data-refdes=\"R2\"] g[data-pad=\"1\"]", "expect": "footer.status span.msg", "expectText": "Batch → revision" },
    { "id": "f6-route-vias", "do": "count", "title": "F6: the routed net has its two vias", "selector": "section[aria-label=\"PCB view\"] g[data-via-id]", "equals": 2 },
    { "id": "f6-airwires-1", "do": "count", "title": "F6: one airwire left (the other net)", "shot": false, "selector": "section[aria-label=\"PCB view\"] line.airwire", "equals": 1 },
    { "id": "f6-autoroute", "do": "menu", "title": "F6: Route › Auto-route all nets routes the rest", "menu": "Route", "item": "Auto-route all nets", "expect": "footer.status span.msg", "expectText": "AutoRoute → revision", "timeout": 60000 },
    { "id": "f6-airwires-0", "do": "count", "title": "F6: no airwires left", "selector": "section[aria-label=\"PCB view\"] line.airwire", "equals": 0 },
    { "id": "f6-clear", "do": "menu", "title": "F6: Route › Clear all routing asks first (native confirm)", "menu": "Route", "item": "Clear all routing" },
    { "id": "f6-clear-confirm", "do": "accept-dialog", "title": "F6: accept the confirm: ClearRouting", "text": "Clear all routing: this is a destructive change", "expect": "footer.status span.msg", "expectText": "ClearRouting → revision" },
    { "id": "f6-cleared", "do": "count", "title": "F6: no tracks left", "selector": "section[aria-label=\"PCB view\"] g[data-track-id]", "equals": 0 },
    { "id": "f6-cleared-vias", "do": "count", "title": "F6: no vias left", "shot": false, "selector": "section[aria-label=\"PCB view\"] g[data-via-id]", "equals": 0 },
    { "id": "f6-undo", "do": "menu", "title": "F6: Edit › Undo brings the routing back", "menu": "Edit", "item": "Undo", "expect": "section[aria-label=\"PCB view\"] g[data-via-id]" },
    { "id": "f6-undone", "do": "count", "title": "F6: after the undo no airwire is left", "shot": false, "selector": "section[aria-label=\"PCB view\"] line.airwire", "equals": 0 },

    { "id": "f6-zone-tool", "do": "click", "title": "F6: Zone tool (net of the last route, active layer F.Cu)", "shot": false, "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button", "text": "Zone", "expect": "section[aria-label=\"PCB view\"] button", "expectText": "Finish zone" },
    { "id": "f6-zone-1", "do": "click", "title": "F6: zone first corner", "shot": false, "selector": "section[aria-label=\"PCB view\"] svg[aria-label=\"PCB canvas\"]", "dx": -220, "dy": -75 },
    { "id": "f6-zone-2", "do": "click", "title": "F6: zone opposite corner", "selector": "section[aria-label=\"PCB view\"] svg[aria-label=\"PCB canvas\"]", "dx": 220, "dy": 75, "expect": "section[aria-label=\"PCB view\"] button", "expectText": "Finish zone (2 pts)" },
    { "id": "f6-zone-finish", "do": "click", "title": "F6: Finish zone sends AddZone; the engine fill is drawn", "selector": "section[aria-label=\"PCB view\"] button", "text": "Finish zone", "expect": "section[aria-label=\"PCB view\"][data-zone-fills=\"1\"]", "timeout": 30000 },
    { "id": "f6-refill", "do": "menu", "title": "F6: Design › Refill zones recomputes connectivity and DRC", "menu": "Design", "item": "Refill zones", "expect": "footer.status span.msg", "expectText": "Zones refilled", "timeout": 60000 },
    { "id": "f6-select-tool", "do": "click", "title": "F6: back to Select", "shot": false, "selector": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button", "text": "Select", "expect": "section[aria-label=\"PCB view\"] [role=\"toolbar\"][aria-label=\"PCB tools\"] button[aria-pressed=\"true\"]", "expectText": "Select" },
    { "id": "f6-drc", "do": "menu", "title": "F6: Design › Run DRC reports", "menu": "Design", "item": "Run DRC", "expect": "section[aria-label=\"DRC report\"]", "timeout": 60000 },
    { "id": "f6-export-open", "do": "menu", "title": "F6: Manufacturing › Export manufacturing files…", "shot": false, "menu": "Manufacturing", "item": "Export manufacturing files", "expect": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"]" },
    { "id": "f6-export", "do": "click", "title": "F6: Export writes the files", "selector": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"] button.primary", "text": "Export", "expect": "ul[aria-label=\"Exported files\"] li", "timeout": 120000 },
    { "id": "f6-export-close", "do": "click", "title": "F6: close the export dialog", "shot": false, "selector": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"] .modal-head button", "gone": "[role=\"dialog\"][aria-label=\"Export manufacturing files\"]" },
    { "id": "f6-release", "do": "menu", "title": "F6: Manufacturing › Release check… shows the status DRAFT", "menu": "Manufacturing", "item": "Release check", "expect": "[role=\"dialog\"][aria-label=\"Release check\"] section[aria-label=\"Release status\"] strong", "expectText": "DRAFT" },
    { "id": "f6-release-reasons", "do": "wait", "title": "F6: with its blocking reasons listed", "selector": "[role=\"dialog\"][aria-label=\"Release check\"] ul[aria-label=\"Blocking reasons\"] li" }
  ]
}
