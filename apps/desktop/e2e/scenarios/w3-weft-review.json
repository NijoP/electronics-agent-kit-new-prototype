{
  "name": "W3 WEFT conflicts and engineer review",
  "description": "WEFT conflict and approval UI (ADR-0053) in the real window. SETUP: three scripted agent sessions reach the app through its harness endpoint, exactly as eak-mcp would. Agent A proposes a 0.2 mm clearance and asks the engineer to review it; agent B proposes 0.25 mm (the same design rules: an overlap); agent C proposes a capacitor. Tools > Agent activity... shows the overlap with both proposals: Rebase is shown as unavailable (EAK does not rebase), and Re-propose on B discards it and asks agent B on the WEFT bus to propose again, which clears the conflict. A's review request is listed under Review requests for you; Approve sends the verdict on the bus and opens the review, where the engineer applies it. C's proposal, made on the old revision, is then a stale conflict, and Reject discards it and tells agent C. The bus rules and the engineer queue are covered by src-tauri/tests/proposal.rs and crates/eak-harness/tests/weft.rs; the panel by src/shell/activity.test.tsx.",
  "steps": [
    { "id": "home", "do": "wait", "title": "Project Home visible", "selector": "main.home h1", "timeout": 60000 },
    { "id": "fixture", "do": "fixture-project", "title": "Create fixture project", "name": "W3 WEFT Review Fixture", "folder": "w3-weft-fixture" },
    { "id": "open", "do": "click", "title": "Open fixture from Recent projects", "selector": "button.home-row", "text": "W3 WEFT Review Fixture", "expect": "nav[aria-label=\"Application menu\"]" },
    { "id": "w3-a-reg", "do": "fixture-agent-calls", "title": "W3: agent A registers on the WEFT bus (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-a", "session": "w3-a", "calls": [{ "tool": "weft_register", "args": { "tool": "ui-evidence-script" } }], "shot": false },
    { "id": "w3-a-propose", "do": "fixture-agent-propose", "title": "W3: agent A proposes a 0.2 mm clearance (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-a", "session": "w3-a", "proposalTitle": "Clearance 0.2 mm", "rationale": "input stage spacing", "save": "pa", "commands": [{ "type": "SetDesignRules", "min_clearance": 200000 }], "shot": false },
    { "id": "w3-a-ask", "do": "fixture-agent-calls", "title": "W3: agent A asks the engineer to review it (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-a", "session": "w3-a", "calls": [{ "tool": "weft_send", "args": { "kind": "review_request", "to": "engineer", "proposal_id": "$saved:pa", "body": "clearance for the input stage" } }], "shot": false },
    { "id": "w3-b-reg", "do": "fixture-agent-calls", "title": "W3: agent B registers (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-b", "session": "w3-b", "calls": [{ "tool": "weft_register", "args": { "tool": "ui-evidence-script" } }], "shot": false },
    { "id": "w3-b-propose", "do": "fixture-agent-propose", "title": "W3: agent B proposes 0.25 mm on the same rules (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-b", "session": "w3-b", "proposalTitle": "Clearance 0.25 mm", "save": "pb", "commands": [{ "type": "SetDesignRules", "min_clearance": 250000 }], "shot": false },
    { "id": "w3-c-propose", "do": "fixture-agent-propose", "title": "W3: agent C proposes a capacitor (SETUP)", "folder": "w3-weft-fixture", "agent": "w3-c", "session": "w3-c", "proposalTitle": "Decoupling", "save": "pc", "commands": [{ "type": "PlaceSymbol", "component_id": "C_0805", "position": { "x": 20000000, "y": 40000000 } }], "shot": false },
    { "id": "sch", "do": "menu", "title": "Open schematic", "menu": "View", "item": "Go to Schematic editor", "expect": "section[aria-label=\"Schematic view\"]", "shot": false },
    { "id": "w3-open", "do": "menu", "title": "W3: the activity view flags the overlap between A's and B's proposals", "menu": "Tools", "item": "Agent activity…", "expect": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict=\"overlap\"] [data-conflict-proposal=\"$saved:pb\"]" },
    { "id": "w3-both", "do": "wait", "title": "W3: both proposals of the overlap are listed", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict=\"overlap\"] [data-conflict-proposal=\"$saved:pa\"]", "shot": false },
    { "id": "w3-rebase", "do": "wait", "title": "W3: Rebase is shown as unavailable (EAK does not rebase)", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict-proposal=\"$saved:pb\"] button[disabled]", "text": "Rebase", "shot": false },
    { "id": "w3-request", "do": "wait", "title": "W3: agent A's review request is listed for the engineer", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] section[aria-label=\"Review requests for you\"] [data-review-request=\"$saved:pa\"]" },
    { "id": "w3-repropose", "do": "click", "title": "W3: Re-propose on B discards it and asks agent B on the bus to propose again; the overlap clears", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict-proposal=\"$saved:pb\"] button", "text": "Re-propose", "expect": "[role=\"dialog\"][aria-label=\"Agent activity\"] p.activity-note", "expectText": "Proposal $saved:pb sent back", "gone": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict=\"overlap\"]" },
    { "id": "w3-told", "do": "wait", "title": "W3: the engineer's verdict is on the bus", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] section[data-actor=\"engineer\"] li[data-activity=\"weft\"][data-kind=\"review_verdict\"]", "shot": false },
    { "id": "w3-approve", "do": "click", "title": "W3: Approve sends the verdict and opens A's proposal in the review", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-review-request=\"$saved:pa\"] button", "text": "Approve", "gone": "[role=\"dialog\"][aria-label=\"Agent activity\"]", "expect": "[role=\"dialog\"][aria-label=\"Review agent proposal\"] button.primary:not([disabled])", "expectText": "Apply proposal" },
    { "id": "w3-apply", "do": "click", "title": "W3: the engineer applies it", "selector": "[role=\"dialog\"][aria-label=\"Review agent proposal\"] button.primary", "text": "Apply proposal", "gone": "[role=\"dialog\"][aria-label=\"Review agent proposal\"]", "expect": "footer.status span.msg", "expectText": "Applied as one undo step" },
    { "id": "w3-open-2", "do": "menu", "title": "W3: C's proposal, made on the old revision, is now a stale conflict", "menu": "Tools", "item": "Agent activity…", "expect": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict=\"stale\"] [data-conflict-proposal=\"$saved:pc\"]" },
    { "id": "w3-reject", "do": "click", "title": "W3: Reject discards it and tells agent C on the bus", "selector": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict-proposal=\"$saved:pc\"] button", "text": "Reject", "expect": "[role=\"dialog\"][aria-label=\"Agent activity\"] p.activity-note", "expectText": "Proposal $saved:pc rejected", "gone": "[role=\"dialog\"][aria-label=\"Agent activity\"] [data-conflict=\"stale\"]" },
    { "id": "w3-close", "do": "key", "title": "W3: Escape closes the activity view", "keys": "Escape", "gone": "[role=\"dialog\"][aria-label=\"Agent activity\"]", "shot": false },
    { "id": "w3-sheet", "do": "count", "title": "W3: the rejected capacitor never reached the sheet", "selector": "section[aria-label=\"Schematic view\"] g[data-symbol-id]", "equals": 0, "shot": false }
  ]
}
