{
  "name": "D3 output documents",
  "description": "Opens an isolated software fixture project (SETUP) and places a built-in resistor with real X input. File > Export BOM: the engine's preview follows the column picker (a column removed, a column added) and a custom header; a filter rule is added; Export CSV runs ERC/DRC/MECH/DFM and shows the manifest: DRAFT (no board outline, gates not passed) with the BOM and its configuration listed. Reopening the dialog shows the same columns and header (the configuration round-trips). File > Export schematic and netlist: schematic PDF and SVG, IPC-D-356 and JSON netlist are written and listed in a DRAFT manifest. Native dropdowns (sort, grouping, format) are covered by unit tests (src/shell/outputs.test.tsx); file contents (PDF title block, IPC-D-356 columns, XLSX parts) by crates/eak-manufacturing tests.",
  "steps": [
    {
      "id": "home",
      "do": "wait",
      "title": "Project Home visible",
      "selector": "main.home h1",
      "timeout": 60000
    },
    {
      "id": "fixture",
      "do": "fixture-project",
      "title": "Create fixture project",
      "name": "D3 Output Fixture"
    },
    {
      "id": "open",
      "do": "click",
      "title": "Open fixture from Recent projects",
      "selector": "button.home-row",
      "text": "D3 Output Fixture",
      "expect": "nav[aria-label=\"Application menu\"]"
    },
    {
      "id": "d3-quick-open",
      "do": "key",
      "title": "D3: Quick open (Ctrl+P) to arm the Place tool with a part",
      "keys": "ctrl+p",
      "expect": "[role=\"dialog\"][aria-label=\"Quick open\"]",
      "shot": false
    },
    {
      "id": "d3-quick-type",
      "do": "type",
      "title": "D3: type the part name",
      "value": "Resistor 0603",
      "expect": "[role=\"dialog\"][aria-label=\"Quick open\"] [role=\"option\"][aria-selected=\"true\"]",
      "expectText": "Resistor 0603",
      "shot": false
    },
    {
      "id": "d3-quick-arm",
      "do": "key",
      "title": "D3: Enter arms the schematic Place tool",
      "keys": "Return",
      "gone": "[role=\"dialog\"][aria-label=\"Quick open\"]",
      "shot": false
    },
    {
      "id": "d3-place",
      "do": "click",
      "title": "D3: XTest click on the schematic places the resistor",
      "selector": "svg[aria-label=\"Schematic canvas\"]"
    },
    {
      "id": "d3-bom-open",
      "do": "menu",
      "title": "D3: File > Export BOM opens the dialog; the engine computes the preview",
      "menu": "File",
      "item": "Export BOM",
      "expect": "[role=\"dialog\"][aria-label=\"Export BOM\"] table[aria-label=\"BOM preview table\"] td",
      "expectText": "R"
    },
    {
      "id": "d3-col-off",
      "do": "click",
      "title": "D3: column picker: untick Manufacturer",
      "selector": "input[aria-label=\"Column Manufacturer\"]",
      "shot": false
    },
    {
      "id": "d3-col-off-gone",
      "do": "absent",
      "title": "D3: the preview no longer has a Manufacturer column",
      "selector": "table[aria-label=\"BOM preview table\"] th",
      "text": "Manufacturer",
      "timeout": 10000
    },
    {
      "id": "d3-col-on",
      "do": "click",
      "title": "D3: column picker: tick Assembled by Fabricator; the preview gains that column",
      "selector": "input[aria-label=\"Column Assembled by Fabricator\"]",
      "expect": "table[aria-label=\"BOM preview table\"] th",
      "expectText": "Assembled by Fabricator"
    },
    {
      "id": "d3-header",
      "do": "type",
      "title": "D3: custom header for Comment shows in the preview",
      "selector": "input[aria-label=\"Header for Comment\"]",
      "value": "Value",
      "expect": "table[aria-label=\"BOM preview table\"] th",
      "expectText": "Value"
    },
    {
      "id": "d3-filter",
      "do": "click",
      "title": "D3: add a filter rule (remove rows whose Comment contains DNP)",
      "selector": "[role=\"dialog\"][aria-label=\"Export BOM\"] button",
      "text": "Add filter rule",
      "expect": "input[aria-label=\"Filter 1 value\"]"
    },
    {
      "id": "d3-bom-export",
      "do": "click",
      "title": "D3: Export CSV runs ERC/DRC/MECH/DFM; the manifest is DRAFT",
      "selector": "[role=\"dialog\"][aria-label=\"Export BOM\"] button.primary",
      "text": "Export CSV",
      "expect": "[role=\"dialog\"][aria-label=\"Export BOM\"] section[aria-label=\"Manufacturing export\"] strong",
      "expectText": "DRAFT — not for fabrication",
      "timeout": 90000
    },
    {
      "id": "d3-bom-files",
      "do": "wait",
      "title": "D3: the manifest lists the BOM and its saved configuration",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-BOM.config.json"
    },
    {
      "id": "d3-bom-csv",
      "do": "wait",
      "title": "D3: the BOM CSV is listed",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-BOM.csv",
      "shot": false
    },
    {
      "id": "d3-bom-close",
      "do": "click",
      "title": "D3: close the BOM dialog",
      "selector": "[role=\"dialog\"][aria-label=\"Export BOM\"] .modal-head button",
      "text": "Close",
      "gone": "[role=\"dialog\"][aria-label=\"Export BOM\"]",
      "shot": false
    },
    {
      "id": "d3-bom-reopen",
      "do": "menu",
      "title": "D3: reopened, the dialog keeps the custom header (configuration round-trips)",
      "menu": "File",
      "item": "Export BOM",
      "expect": "table[aria-label=\"BOM preview table\"] th",
      "expectText": "Value"
    },
    {
      "id": "d3-bom-reopen-col",
      "do": "absent",
      "title": "D3: and the removed Manufacturer column stays removed",
      "selector": "table[aria-label=\"BOM preview table\"] th",
      "text": "Manufacturer",
      "timeout": 5000
    },
    {
      "id": "d3-bom-close2",
      "do": "click",
      "title": "D3: close the BOM dialog again",
      "selector": "[role=\"dialog\"][aria-label=\"Export BOM\"] .modal-head button",
      "text": "Close",
      "gone": "[role=\"dialog\"][aria-label=\"Export BOM\"]",
      "shot": false
    },
    {
      "id": "d3-docs-open",
      "do": "menu",
      "title": "D3: File > Export schematic and netlist",
      "menu": "File",
      "item": "Export schematic and netlist",
      "expect": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"]"
    },
    {
      "id": "d3-docs-svg",
      "do": "click",
      "title": "D3: add Schematic SVG (ticked)",
      "selector": "input[aria-label=\"Schematic SVG\"]",
      "shot": false,
      "expect": "input[aria-label=\"Schematic SVG\"]:checked"
    },
    {
      "id": "d3-docs-away1",
      "do": "move",
      "title": "D3: pointer to the dialog heading (no label tooltip over the next control)",
      "selector": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"] h2",
      "shot": false
    },
    {
      "id": "d3-docs-json",
      "do": "click",
      "title": "D3: add JSON netlist (ticked)",
      "selector": "input[aria-label=\"JSON netlist\"]",
      "shot": false,
      "expect": "input[aria-label=\"JSON netlist\"]:checked"
    },
    {
      "id": "d3-docs-away2",
      "do": "move",
      "title": "D3: pointer to the dialog heading (no label tooltip over the next control)",
      "selector": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"] h2",
      "shot": false
    },
    {
      "id": "d3-docs-export",
      "do": "click",
      "title": "D3: Export writes the documents; the manifest is DRAFT",
      "selector": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"] button.primary",
      "text": "Export",
      "expect": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"] section[aria-label=\"Manufacturing export\"] strong",
      "expectText": "DRAFT — not for fabrication",
      "timeout": 90000
    },
    {
      "id": "d3-docs-pdf",
      "do": "wait",
      "title": "D3: schematic PDF listed in the manifest",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-schematic.pdf"
    },
    {
      "id": "d3-docs-svg-file",
      "do": "wait",
      "title": "D3: schematic SVG listed",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-schematic-1.svg",
      "shot": false
    },
    {
      "id": "d3-docs-ipc",
      "do": "wait",
      "title": "D3: IPC-D-356 netlist listed",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-netlist.ipc",
      "shot": false
    },
    {
      "id": "d3-docs-json-file",
      "do": "wait",
      "title": "D3: JSON netlist listed",
      "selector": "ul[aria-label=\"Exported files\"] li",
      "text": "D3_Output_Fixture-netlist.json"
    },
    {
      "id": "d3-docs-close",
      "do": "click",
      "title": "D3: close the dialog",
      "selector": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"] .modal-head button",
      "text": "Close",
      "gone": "[role=\"dialog\"][aria-label=\"Export schematic and netlist\"]"
    }
  ]
}
